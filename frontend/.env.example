# Chess UNO Frontend Environment Configuration

# Backend API Base URL
# Leave empty in local development to let Vite proxy requests to the backend server.
# Set to an absolute URL (e.g., http://localhost:5000 or https://api.chessuno.com) for cross-origin deployments.
VITE_API_BASE_URL=

# Frontend Application Base URL
# Leave empty to automatically adapt to the browser's current window.location.origin (e.g., http://localhost:5173).
# Set to an explicit URL (e.g., https://chessuno.com) if running behind reverse proxies or custom domains.
VITE_APP_BASE_URL=

