# =====================================================================
# Chess UNO Production Environment Variables (/etc/chessuno/chessuno.env)
# Set file permissions: sudo chmod 600 /etc/chessuno/chessuno.env
# =====================================================================

# ASP.NET Core environment and local binding (keep on 127.0.0.1 behind Nginx/Caddy)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# PostgreSQL Connection String (double underscore for nested keys)
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=chessuno;Username=postgres;Password=YOUR_ACTUAL_PASSWORD_HERE;

# MANDATORY IN PRODUCTION: HMAC key for player secret token security (minimum 32 characters)
# Generate with: openssl rand -base64 32
CHESSUNO_HMAC_KEY=REPLACE_WITH_MIN_32_CHAR_HMAC_SECRET_KEY!

# Optional key rotation support:
# CHESSUNO_PREVIOUS_HMAC_KEY=

# Frontend base URL for invitation links
FrontendBaseUrl=https://chessuno.example.com
